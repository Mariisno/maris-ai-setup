{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|WebFetch|WebSearch|Grep|Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/bin/lola-dig-guard", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/bin/lola-dig-guard", "timeout": 5 }
        ]
      }
    ]
  }
}
